  Booktitle                = {Proc. Joint 31st Int. Conf. Infrared Millimeter Waves and 14th Int. Conf. Teraherz Electronics IRMMW-THz 2006},
  Year                     = {2006},
   Abstract                 = {We have developed a <span class='snippet'>near</span>-<span class='snippet'>field</span> spectrometer operating in the THz-range between 30 GHz and 1.4 THz, where we use backward-wave oscillators (BWO) as continues wave sources and a photo-induced aperture as <span class='snippet'>near</span>-<span class='snippet'>field</span> probe. This instrument allows performing THz-imaging and <span class='snippet'>spectroscopy</span> with sub-wavelength resolution without a complicated probe-sample distance control and with a continuously adjustable aperture.},
